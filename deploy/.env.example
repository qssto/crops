# 复制为 deploy/.env 并填入随机值（deploy/.env 不入库）。
# docker compose、cmd/server、cmd/migrate、cmd/eval、cmd/devtoken 都从环境变量读取以下密钥；
# Makefile 会自动 include deploy/.env 并 export。手动运行时：set -a; . deploy/.env; set +a
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
MINIO_USER=
MINIO_PASSWORD=
# HS256 签名密钥，至少 32 字节
AUTH_JWT_SECRET=
