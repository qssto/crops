{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agri-steward.local/contracts/v1/advice_card.schema.json",
  "x-contract-version": 1,
  "title": "AdviceCard",
  "description": "Agent 产出的一条结构化建议，必带 Citation，不含执行动作。",
  "type": "object",
  "additionalProperties": false,
  "required": ["advice_id", "run_id", "tenant_id", "farm_id", "field_id", "crop", "category", "outcome",
    "degraded", "conclusion", "reasons", "citations", "confidence", "next_action"],
  "properties": {
    "advice_id": {"type": "integer", "minimum": 1},
    "run_id": {"type": "integer", "minimum": 1},
    "tenant_id": {"type": "integer", "minimum": 1},
    "farm_id": {"type": "integer", "minimum": 1},
    "field_id": {"type": "integer", "minimum": 1},
    "crop": {"type": "string", "minLength": 1, "maxLength": 32},
    "phenology_stage": {"type": "string", "maxLength": 32},
    "category": {"enum": ["protect", "fertilize", "irrigate", "disaster"]},
    "advice_type": {"enum": ["作业类", "观察类"]},
    "outcome": {"enum": ["ADVICE", "REFUSED"]},
    "refuse_reason": {"type": "string", "minLength": 1, "maxLength": 32},
    "degraded": {"type": "boolean"},
    "conclusion": {"type": "string", "maxLength": 512},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "product_candidates": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "selected_product": {"type": "string", "minLength": 1, "maxLength": 64},
    "numbers": {"type": "array", "items": {"$ref": "#/$defs/number"}},
    "citations": {"type": "array", "items": {"$ref": "https://agri-steward.local/contracts/v1/citation.schema.json"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "suggested_window": {"$ref": "#/$defs/time_window"},
    "next_action": {"enum": ["CREATE_ORDER", "OBSERVE", "NONE"]}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "ADVICE"}}},
      "then": {"required": ["advice_type"], "properties": {"citations": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "REFUSED"}}},
      "then": {"required": ["refuse_reason"]}
    }
  ],
  "$defs": {
    "number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "unit"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "format": "date-time"},
        "to": {"type": "string", "format": "date-time"}
      }
    }
  }
}
